# YouTube 去广告 - Anywhere MITM RuleSet
# SAFE 版：保留推荐流，避免空白首页
#
# 功能：
# - 保留此前有效的视频播放广告 request protobuf pruning；
# - 只删除 JSON 响应里“明确广告 renderer”的数组项；
# - 不再清理未知 protobuf response，避免误删整个推荐页。
#
# 上传 GitHub 后使用 Raw URL 导入 Anywhere。
# 建议：导入后杀掉 YouTube 后台，必要时清缓存再测试。

name = YouTube去广告 SAFE
hostname = youtubei.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, s.youtube.com, googlevideo.com

# 视频广告：request protobuf pruning
0, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|player|search|guide)(?:\?|$), 
0, 100, ^/youtubei/v1/(?:browse|player|search|guide)(?:\?|$), 

# googlevideo oad/initplayback 拦截
0, 100, ^https://[\w-]+\.googlevideo\.com/initplayback.*[?&]oad(?:[=&]|$), 
0, 100, ^/initplayback.*[?&]oad(?:[=&]|$), 

# 尽量让 JSON API 响应可读
0, 2, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|guide|get_watch)(?:\?|$), accept-encoding
0, 1, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|guide|get_watch)(?:\?|$), accept-encoding, identity
0, 2, ^/youtubei/v1/(?:browse|next|player|search|guide|get_watch)(?:\?|$), accept-encoding
0, 1, ^/youtubei/v1/(?:browse|next|player|search|guide|get_watch)(?:\?|$), accept-encoding, identity

# 瀑布流：仅保守清理 JSON 明确广告 renderer，不碰 protobuf response
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|search|guide|get_watch)(?:\?|$), 
1, 100, ^/youtubei/v1/(?:browse|next|search|guide|get_watch)(?:\?|$), 

# YouTube web/ad/stat tracking endpoints
0, 0, ^https://(?:www|s)\.youtube\.com/api/stats/ads, 2
0, 0, ^https://(?:www|s)\.youtube\.com/(?:pagead|ptracking), 2
0, 0, ^https://s\.youtube\.com/api/stats/qoe\?adcontext, 2
0, 0, ^/api/stats/ads, 2
0, 0, ^/(?:pagead|ptracking), 2
0, 0, ^/api/stats/qoe\?adcontext, 2
