name = Apple WLOC 定位修改
hostname = gs-loc.apple.com, gs-loc-cn.apple.com

# response body script: dist/wloc.js
1, 100, ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc, 

# request synthetic response script: dist/wloc-settings.js
0, 100, ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save, 
