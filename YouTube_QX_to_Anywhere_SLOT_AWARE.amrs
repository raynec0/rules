# YouTube去广告隐藏Shorts版 - Anywhere MITM RuleSet
# Slot-aware build:
# - 按原 QX Youtube.snippet 入口改写
# - 写法参考 XiaohongshuBlockAD.amrs 的 base64 JS 脚本规则
# - 修复瀑布流“空白-视频-空白”：只删除 ad-like 且非 video-like 的 protobuf item/slot

name = YouTube去广告隐藏Shorts版
hostname = *.googlevideo.com, redirector*.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com

# request: QX 302 / reject-200 / youtubei request protobuf adSignals pruning
0, 100, ^https://[^/]+/, 

# response: youtubei JSON/protobuf feed item cleaner
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch), 
