# YouTube去广告隐藏Shorts版 - Anywhere MITM RuleSet
# 从 QX Youtube.snippet 从头改写，写法参考 XiaohongshuBlockAD.amrs：
# 单条 0/1,100 脚本规则 + base64 JS，在脚本内部按 ctx.url 分流处理。
#
# 原 QX 包含：
# - googlevideo ctier=L 302
# - googlevideo oad / youtube stats/pagead/ptracking reject-200
# - youtubei browse/next/player/search/reel/guide/account/get_setting/get_watch script-response-body
#
# 本版：
# - 保留视频贴片有效的 request protobuf adSignals pruning；
# - response 侧同时尝试 JSON 与 protobuf；
# - protobuf feed 使用“有限层级向上删除”，避免只去图片，也避免整页空白。

name = YouTube去广告隐藏Shorts版
hostname = *.googlevideo.com, redirector*.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com

0, 100, ^https://[^/]+/, 
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch), 
