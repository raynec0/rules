# YouTube 去广告 - Anywhere MITM RuleSet
# FINAL MAX: 视频广告 + 瀑布流广告，JSON/protobuf 双清理
# 上传到 GitHub 后使用 Raw URL 导入 Anywhere。
#
# 注意：
# - Anywhere 官方文档的 script op 是 4；部分测试版/旧版 UI 会显示/接受 100。
#   因此这里同时放 4 和 100 兼容行，能识别哪个就用哪个。
# - 官方文档说明规则 pattern 匹配 path-and-query；这里也额外放了 full URL 兼容行。
# - 测试前建议杀掉 YouTube 后台并清缓存；同时阻断 UDP/443 QUIC。

name = YouTube去广告 MAX
hostname = youtubei.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, s.youtube.com, googlevideo.com

# Decompress / force identity when possible.
0, 2, ^/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), accept-encoding
0, 1, ^/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account|get_setting|get_watch)(?:\?|$), accept-encoding, identity
0, 2, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), accept-encoding
0, 1, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account|get_setting|get_watch)(?:\?|$), accept-encoding, identity

# Video ad / feed ad unified script: request protobuf + response JSON/protobuf.
0, 4, ^/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 
1, 4, ^/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 
0, 100, ^/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 
1, 100, ^/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 

# Compatibility with builds that gate on full URL.
0, 4, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 
1, 4, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 
0, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 

# googlevideo oad / tracking rejects.
0, 0, ^/(?!dclk_video_ads|videoplayback\?).*&oad, /__blocked__
0, 0, ^/api/stats/ads, /__blocked__
0, 0, ^/(?:pagead|ptracking), /__blocked__
0, 0, ^/api/stats/qoe\?adcontext, /__blocked__
