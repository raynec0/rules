# Anywhere Rule Set
# YouTube ad/Shorts cleaner
# Converted from Quantumult X style snippet, adapted for Anywhere MITM.
# Upload this file to GitHub, then import the raw GitHub URL in Anywhere.
#
# Notes:
# - The QX ctier 302 rule is intentionally omitted because Anywhere replacements are literal
#   and do not expand $1 / $2 / $3 capture groups.
# - Script processing only handles JSON responses. Protobuf/binary responses pass through unchanged.

name = YouTube AD Block
hostname = googlevideo.com, youtube.com, youtubei.googleapis.com

# googlevideo ad beacon / oad
0, 0, ^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad, 2,

# YouTube ad/stat tracking endpoints
0, 0, ^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads, 2,
0, 0, ^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking), 2,
0, 0, ^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext, 2,

# YouTube JSON API response cleaner
1, 100, ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch), 
