# YouTube 去广告 - Anywhere MITM RuleSet
# FINAL PLUS: 视频广告 + 瀑布流信息流广告
# 上传到 GitHub 后，使用 Raw URL 导入 Anywhere。
#
# 使用建议：
# 1. Anywhere 里启用 MITM，并安装/信任证书。
# 2. Hostnames 必须包含 youtubei.googleapis.com、youtube.com、googlevideo.com。
# 3. 关闭/拦截 QUIC/UDP 443，否则 YouTube 可能绕过 MITM。
# 4. 如果 YouTube 已缓存推荐流，重启 YouTube 或清缓存后再测。

name = YouTube去广告 Plus
hostname = youtubei.googleapis.com, googlevideo.com, youtube.com, www.youtube.com, m.youtube.com, s.youtube.com

# 1. 视频播放广告：protobuf request pruning
0, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|player|search|guide)(?:\?|$), 

# 2. googlevideo oad/initplayback 拦截
0, 100, ^https://[\w-]+\.googlevideo\.com/initplayback.*[?&]oad(?:[=&]|$), 

# 3. 让 YouTube JSON API 尽量返回可读响应体，方便响应脚本清理瀑布流
0, 2, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), accept-encoding
0, 1, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), accept-encoding, identity

# 4. 瀑布流广告：response JSON renderer cleaner
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|search|guide|get_watch|reel/reel_watch_sequence)(?:\?|$), 

# 5. YouTube web/ad/stat tracking endpoints
0, 0, ^https://(?:www|s)\.youtube\.com/api/stats/ads, 2
0, 0, ^https://(?:www|s)\.youtube\.com/(?:pagead|ptracking), 2
0, 0, ^https://s\.youtube\.com/api/stats/qoe\?adcontext, 2
