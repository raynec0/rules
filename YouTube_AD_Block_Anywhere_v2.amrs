# YouTube AD Block for Anywhere MITM
# Upload this .amrs to GitHub and import the Raw URL in Anywhere.
# Important: this is an Anywhere-native approximation, not a full QX protobuf port.

name = YouTube AD Block
hostname = googlevideo.com, youtube.com, youtubei.googleapis.com

# Force API responses into plain body for script processing where possible.
0, 2, ^/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(\?|$), accept-encoding
0, 1, ^/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(\?|$), accept-encoding, identity

# googlevideo ad-ish request rewrites / rejects, using Anywhere's current app-compatible rule form.
0, 0, ^/(?!dclk_video_ads).*&oad, 2, {}

# YouTube ad/stat tracking endpoints.
0, 0, ^/api/stats/ads, 2, {}
0, 0, ^/(pagead|ptracking), 2, {}
0, 0, ^/api/stats/qoe\?adcontext, 2, {}

# YouTube JSON API response cleaner.
# Official MITM.md uses operation 4 for script. Older examples sometimes showed 100.
1, 4, ^/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(\?|$), 
